# ============================================================
# 环境变量模板
# 用法：把本文件复制一份，重命名为 .env，然后填入你自己的 Key。
#     Windows PowerShell:  Copy-Item .env.example .env
#     macOS / Linux:       cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 排除，不会上传到 GitHub。
#    .env.example 只放「变量名」，永远不要放真实 Key。
# ============================================================

# ------------------------------------------------------------
# 翻译 API（阶段 2 使用，现在可以先空着）
# ------------------------------------------------------------
# 方案 A：DeepL（推荐，科研文本质量最好；免费版每月 50 万字符）
# 注册地址：https://www.deepl.com/pro-api
# 免费版 Key 末尾通常是 ":fx"（Free 版），付费版没有后缀
DEEPL_API_KEY=

# 方案 B：OpenAI（备选，用 GPT 模型翻译，可自定义术语）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 方案 C：Google Translate（备选，需要 Google Cloud 账号并开通翻译 API）
GOOGLE_TRANSLATE_API_KEY=

# 默认使用哪个翻译后端：deepl / openai / google
TRANSLATOR_BACKEND=deepl

# ------------------------------------------------------------
# GROBID 服务地址（阶段 4.3 使用，本地 Docker 启动）
# ------------------------------------------------------------
GROBID_URL=http://localhost:8070
